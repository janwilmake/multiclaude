#!/usr/bin/env bash
set -euo pipefail
[ $# -ge 1 ] || { echo 'usage: cca "prompt" [--non-interactive] [claude flags...]'; exit 1; }

PROMPT="$1"; shift
# Everything after the prompt is passed to `claude` verbatim — e.g.
# --dangerously-skip-permissions for an unattended run, or --model to pick a
# model per agent. %q-quote each one now so the generated .command script
# can't mangle spaces or reinterpret metacharacters.
#
# --non-interactive is cca's own flag and never reaches claude. It says nobody
# is going to read this window, which is the one thing cca cannot work out for
# itself: an agent with a genuine question looks exactly like an agent that
# has finished.
NONINTERACTIVE=0
FLAGS=""
SID=""
prev=""
for f in "$@"; do
  if [ "$f" = --non-interactive ]; then NONINTERACTIVE=1; continue; fi
  FLAGS="$FLAGS $(printf '%q' "$f")"
  [ "$prev" = --session-id ] && SID="$f"
  case "$f" in --session-id=*) SID="${f#*=}" ;; esac
  prev="$f"
done
case "$NONINTERACTIVE$FLAGS" in
  1*--dangerously-skip-permissions*) ;;
  1*) echo "cca: --non-interactive without --dangerously-skip-permissions — an agent stopped at a permission prompt is not a finished agent, and nobody is there to answer it" >&2 ;;
esac

REPO="$PWD"
L="$HOME/.claude/launchers"; mkdir -p "$L"
A="$HOME/.claude/agents"; mkdir -p "$A"

# Each extra slot costs one folder-trust prompt, once, the first time an agent
# lands in it — so raising this is cheap, but 8 windows is already a lot to
# watch.
SLOTS="${CCA_SLOTS:-10}"
# --non-interactive only. Seconds a finished agent leaves its window open
# before closing it, and seconds of silence after the agent stops talking
# before its session ends.
CLOSE_DELAY="${CCA_CLOSE_DELAY:-15}"
GRACE="${CCA_GRACE:-120}"
# --non-interactive only. Seconds after the agent stops talking that its
# background work may keep the session alive, so a hung job frees the slot.
MAX_BUSY="${CCA_MAX_BUSY:-7200}"

# Linux has no Terminal.app, no AppleScript and no APFS clonefile. There the
# agent runs in its screen session with no viewer window, and the copy uses a
# reflink where the filesystem has one.
if [ "$(uname -s)" = Darwin ]; then
  MAC=1; MTIME="stat -f %m"; CLONE="cp -Rc"
else
  MAC=0; MTIME="stat -c %Y"; CLONE="cp -a --reflink=auto"
fi
# --chrome needs a Chrome with the Claude extension, which a headless server lacks.
CHROME=" --chrome"
if [ "$MAC" = 0 ]; then
  CHROME=""
  for c in google-chrome chromium chromium-browser; do
    command -v "$c" >/dev/null 2>&1 && CHROME=" --chrome" && break
  done
fi

MUTEX="$A/.cca-claim"
age() { echo $(( $(date +%s) - $($MTIME "$1" 2>/dev/null || date +%s) )); }

# Slot selection has to be a critical section. It used to happen in two places
# at once — this script picked the first slot with no lock, but the lock itself
# was only created by the spawned window *after* its clone finished, seconds
# later. Eight `cca` calls fired back-to-back therefore all saw every slot free,
# all picked agent-1, and each overwrote the previous one's prompt file: eight
# windows, one directory, one prompt. mkdir is atomic, so it serializes the
# scan-and-claim below; each call holds it for a millisecond or two, which is
# why spawning stays instant.
held=""
for _ in $(seq 1 200); do
  if err="$(mkdir "$MUTEX" 2>&1)"; then held=1; break; fi
  # Only contention is worth waiting out. Every other reason mkdir fails —
  # a sandbox that denies writes under ~/.claude, a read-only home, a missing
  # parent — is just as true ten seconds from now, and retrying turns an
  # instant legible error into a silent stall that looks like cca hanging.
  # Eight spawns swallowing "Operation not permitted" and spinning 10s each
  # is how this was found.
  case "$err" in
    *"File exists"*) ;;
    *) echo "cca: cannot claim a slot: $err" >&2; exit 1 ;;
  esac
  # A cca that died mid-claim leaves the mutex behind. 30s is orders of
  # magnitude longer than the work it guards, so anything older is debris.
  [ "$(age "$MUTEX")" -gt 30 ] && rmdir "$MUTEX" 2>/dev/null || true
  sleep 0.05
done
[ -n "$held" ] || { echo "could not acquire $MUTEX — remove it by hand if no cca is running"; exit 1; }
trap 'rmdir "$MUTEX" 2>/dev/null || true' EXIT

# Fixed slots — a fresh path would re-trigger Claude's folder-trust prompt.
NAME=""
for n in $(seq 1 "$SLOTS"); do
  LOCK="$A/agent-$n.lock"
  # Transitional: locks written by cca before the lock moved out of the work
  # directory. Released by those windows on exit; delete by hand if one sticks.
  if [ -e "$A/agent-$n/.cca-lock" ]; then continue; fi
  if [ -e "$LOCK" ]; then
    pid="$(cat "$LOCK" 2>/dev/null || true)"
    # Live window — slot busy.
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then continue; fi
    # No pid yet means another cca claimed it moments ago and its window hasn't
    # started. Only an old empty lock is debris (window never launched).
    if [ -z "$pid" ] && [ "$(age "$LOCK")" -lt 120 ]; then continue; fi
    rm -f "$LOCK"   # SIGKILL'd window, or a launch that never happened
  fi
  : > "$LOCK"; NAME="agent-$n"; NUM="$n"; break
done
[ -n "$NAME" ] || { echo "all $SLOTS slots busy"; exit 1; }
WORK="$A/$NAME"
LOCK="$A/$NAME.lock"

# Test workers for this agent. A test runner starts one worker per core by
# default, so four agents testing at once asked for 40 workers on 10 cores and
# held the load near 20. Share the cores instead: (cores - 2) over the agents
# running now, this one included, between 1 and 4. Two cores stay for the
# user. The agent's scripts read TEST_WORKERS; CCA_TEST_WORKERS overrides it.
LIVE=1
for n in $(seq 1 "$SLOTS"); do
  [ "agent-$n" = "$NAME" ] && continue
  pid="$(cat "$A/agent-$n.lock" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && LIVE=$(( LIVE + 1 ))
done
CORES="$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)"
WORKERS=$(( (CORES - 2) / LIVE ))
[ "$WORKERS" -lt 1 ] && WORKERS=1
[ "$WORKERS" -gt 4 ] && WORKERS=4
WORKERS="${CCA_TEST_WORKERS:-$WORKERS}"

printf '%s' "$PROMPT" > "$L/$NAME.prompt"

# The hook goes on the command line rather than in the copy's settings file,
# so it dies with the session and cannot outlive it or follow the work back
# into a commit. The marker lives in /tmp because Claude Code's sandbox denies
# writes under ~/.claude/ — a marker there is silently never written.
MARK="/tmp/cca-$(id -u)-$NAME.stop"
HOOK=""
if [ "$NONINTERACTIVE" = 1 ]; then
  HOOK=" --settings $(printf '%q' "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"touch $MARK\"}]}]}}")"
fi

cat > "$L/$NAME.command" <<EOF
#!/bin/bash
printf '\033]0;$NAME\007'
# Claim the slot for real before the slow part: a window killed mid-clone
# should free it, and the empty lock cca left behind should stop looking empty
# as fast as possible. The lock lives beside the work dir, not inside it,
# because the next line deletes the work dir wholesale.
echo \$\$ > "$LOCK"
trap 'rm -f "$LOCK"' EXIT HUP INT TERM
echo "cloning -> $WORK"
rm -rf "$WORK"
mkdir -p "$WORK"
# Clone top-level entries one at a time, skipping what we would only delete again.
# cp -Rc has no --exclude, and clonefile is O(1) in bytes but O(n) in *files* —
# cloning an 86k-file node_modules just to rm -rf it costs ~26s of pure waste.
# clone_dir src dst depth: per-entry clone, skipping junk. A directory that
# holds a node_modules within 2 levels is recursed into (depth-limited) so the
# nested node_modules can be symlinked back to the source instead of cloned —
# mcp/node_modules alone is ~41k files, ~13s of clonefile per spawn for bytes
# nobody needed copied. Covers mcp/ today and packages/xxx/ if it ever exists.
clone_dir() {
  local src="\$1" dst="\$2" depth="\$3" e b
  mkdir -p "\$dst"
  for e in "\$src"/*; do
    b="\$(basename "\$e")"
    case "\$b" in
      node_modules|build|.react-router|coverage) continue ;;
    esac
    if [ -d "\$e" ] && [ "\$depth" -lt 2 ] && [ -n "\$(find "\$e" -mindepth 1 -maxdepth 2 -type d -name node_modules -print -quit 2>/dev/null)" ]; then
      clone_dir "\$e" "\$dst/\$b" "\$((depth + 1))"
    else
      $CLONE "\$e" "\$dst/" || { echo "clonefile failed for \$b, plain copy"; cp -R "\$e" "\$dst/"; }
    fi
  done
  [ -d "\$src/node_modules" ] && [ ! -e "\$dst/node_modules" ] && ln -s "\$src/node_modules" "\$dst/node_modules"
  return 0
}
time (
  shopt -s dotglob
  clone_dir "$REPO" "$WORK" 0
)
rm -rf "$WORK/.claude/worktrees"
cd "$WORK"
export TEST_WORKERS=$WORKERS
# Give the window a colour of its own. The login shell that launched this
# script already ran any cd-hook colouring — back when the cwd was still
# \$HOME — so without this every agent window is the same colour as every
# other. The hue comes from the slot number, not from hashing \$WORK: eight
# sibling paths hash to hues that collide often enough to matter (agent-1 and
# agent-3 landed one degree apart), and evenly spaced slots never can.
# Optional: no termcolor, no colour, nothing else changes.
# https://github.com/janwilmake/termcolor
TC="\$HOME/.local/bin/termcolor"
[ -x "\$TC" ] && { "\$TC" hue $(( (NUM - 1) * 360 / SLOTS )) >/dev/null 2>&1 || "\$TC" auto "$WORK" >/dev/null 2>&1; }
EOF

# Everything below only exists in an unattended launcher. An interactive one
# is the script it always was: run claude, drop into a shell, and wait for a
# human — who may well be the point, if the agent has a question worth asking.
if [ "$NONINTERACTIVE" = 1 ]; then
cat >> "$L/$NAME.command" <<EOF

rm -f "$MARK" "$MARK.ended"
SELF=\$\$
# busy PID: prints why the claude process PID is not done yet, or nothing.
# A Bash-tool command, run_in_background or Monitor, runs in a shell that
# claude starts in a process group of its own; MCP servers stay in claude's
# group, so they never count. A background subagent runs inside claude and
# leaves no process; claude writes how many are still running into the
# transcript at the end of each turn, so that is read when --session-id says
# which transcript is this session's.
busy() {
  ps -A -o pid= -o ppid= -o pgid= -o comm= | awk -v c="\$1" '\$2 == c && \$1 == \$3 && \$4 ~ /(^|\/)-?(ba|z|da|k)?sh\$/ { print "shell job, process group " \$3 }'
  t="\$(ls -t "$HOME"/.claude/projects/*/"$SID".jsonl 2>/dev/null | head -1)"
  [ -n "\$t" ] && grep '"subtype":"turn_duration"' "\$t" | tail -1 |
    grep -o '"pendingBackgroundAgentCount":[1-9][0-9]*' | sed 's/.*:/background agents: /'
  return 0
}
(
  # The Stop hook touches the marker every time the agent stops talking, also
  # when it stops to wait for its own background work. End the session only
  # once the marker has stayed still and nothing ran in the background for
  # $GRACE seconds: if someone replies, or a background job finishes and the
  # agent reads its result, the agent talks again and the marker moves.
  while kill -0 \$SELF 2>/dev/null; do
    if [ -e "$MARK" ]; then
      t0="\$($MTIME "$MARK")"
      quiet="\$(date +%s)"
      while :; do
        sleep 5
        [ "\$t0" = "\$($MTIME "$MARK" 2>/dev/null || echo moved)" ] || continue 2
        cpid="\$(pgrep -P \$SELF -x claude | head -1)"
        [ -n "\$cpid" ] || exit 0
        now="\$(date +%s)"
        why="\$(busy "\$cpid")"
        if [ -n "\$why" ]; then
          # The work may have run until the next check, 5s from now.
          quiet=\$(( now + 5 ))
          [ \$(( now - t0 )) -ge $MAX_BUSY ] || continue
          msg="$NAME still had background work ${MAX_BUSY}s after it stopped talking (CCA_MAX_BUSY) — session ended. Still running: \$(echo \$why)"
          break
        fi
        [ \$(( now - quiet )) -ge $GRACE ] || continue
        msg="$NAME finished and nobody replied for ${GRACE}s — session ended."
        break
      done
      # The launcher prints the reason once claude has left the screen, and
      # kills this loop as soon as claude exits.
      echo "\$msg" > "$MARK.ended"
      groups="\$(busy "\$cpid" | sed -n 's/^shell job, process group //p')"
      kill "\$cpid"
      for g in \$groups; do kill -- -"\$g" 2>/dev/null; done
      exit 0
    fi
    sleep 5
  done
) &
watchdog=\$!

EOF
fi

cat >> "$L/$NAME.command" <<EOF
claude$CHROME$HOOK$FLAGS "\$(cat "$L/$NAME.prompt")"
EOF

if [ "$NONINTERACTIVE" = 1 ]; then
cat >> "$L/$NAME.command" <<EOF
kill "\$watchdog" 2>/dev/null
cat "$MARK.ended" 2>/dev/null
rm -f "$MARK.ended"

# The window closes when the agent finishes, whether or not the copy still
# holds work. It used to keep the slot over uncommitted changes or unpushed
# commits, which meant a run nobody watched ended with eight windows open and
# no free slots. The countdown is the escape hatch: the next agent to take
# this slot deletes the directory, so press a key to keep anything in $WORK.
echo ""
echo "$NAME is done — closing in ${CLOSE_DELAY}s. Press any key to keep the window."
if ! read -r -t $CLOSE_DELAY -n 1; then
  # Terminal will not close a window that still has processes on its tty; it
  # puts up a "terminate running processes?" dialog instead, which is worse
  # than leaving the window open. So the close is handed to a helper that
  # leaves the tty session and fires once this script and its login shell
  # are gone. If python3 is missing the window just stays — the slot is
  # freed either way, by the EXIT trap below.
  [ $MAC = 1 ] && /usr/bin/python3 - "\$(tty)" 2>/dev/null <<'PY'
import os, subprocess, sys, time
if os.fork() == 0:
    os.setsid()
    time.sleep(2)
    subprocess.run(["osascript", "-e",
        'on run argv\ntell application "Terminal" to close '
        '(every window whose tty of tabs contains (item 1 of argv))\nend run',
        sys.argv[1]])
    os._exit(0)
PY
  exit 0
fi
EOF
fi

cat >> "$L/$NAME.command" <<EOF
# Deliberately not \`exec\`: exec replaces the process image and discards the
# EXIT trap, so the lock would never be released and the slot would leak.
"\$SHELL"
EOF

chmod +x "$L/$NAME.command"
echo "$NAME -> $WORK"
# CCA_WINDOW=1 is the old launch: the agent runs in the Terminal window itself.
if [ "${CCA_WINDOW:-0}" = 1 ]; then
  open -a Terminal "$L/$NAME.command"
  exit 0
fi

# The agent runs in a detached screen session, so no window owns it. Terminal
# starts a .command by typing its path into the new window's shell; a key the
# user presses while that window has focus lands in front of the path, and the
# agent never started. Now that typed command only opens a viewer, so a stray
# key breaks the view, never the agent: `screen -r agent-N` reattaches.
#
# env -i: cca usually runs under a Claude Code session, whose CLAUDECODE and
# CLAUDE_CODE_* variables would make the agent's claude think it is nested.
# The login shell gives the agent the same environment a Terminal window had.
env -i HOME="$HOME" USER="${USER:-$(id -un)}" LOGNAME="${LOGNAME:-$(id -un)}" \
  SHELL="${SHELL:-/bin/zsh}" TMPDIR="${TMPDIR:-/tmp/}" LANG="${LANG:-en_US.UTF-8}" \
  PATH="/usr/bin:/bin:/usr/sbin:/sbin" TERM=xterm-256color \
  /usr/bin/screen -T screen-256color -dmS "$NAME" \
  "${SHELL:-/bin/zsh}" -lic "exec /bin/bash $(printf '%q' "$L/$NAME.command")"

if [ "$MAC" = 0 ]; then
  echo "watch it: screen -r $NAME"
  exit 0
fi

cat > "$L/$NAME.view.command" <<EOF
#!/bin/bash
printf '\033]0;$NAME\007'
# Find this window's id while its tty still answers: once the shell has ended,
# Terminal no longer reports a tty for the window, so it can only be closed by id.
WID="\$(osascript - "\$(tty)" 2>/dev/null <<'AS'
on run argv
  tell application "Terminal"
    repeat with w in windows
      try
        repeat with t in tabs of w
          if tty of t is (item 1 of argv) then return id of w
        end repeat
      end try
    end repeat
  end tell
end run
AS
)"
for _ in \$(seq 1 100); do
  /usr/bin/screen -ls "$NAME" 2>/dev/null | grep -q "\.$NAME[[:space:]]" && break
  sleep 0.1
done
/usr/bin/screen -r "$NAME"
# The session ended or was detached: close this viewer window. Terminal will
# not close a window that still has processes on its tty, so a helper outside
# the tty session does it once this script and its login shell are gone.
[ -n "\$WID" ] && /usr/bin/python3 - "\$WID" 2>/dev/null <<'PY'
import os, subprocess, sys, time
if os.fork() == 0:
    os.setsid()
    time.sleep(2)
    subprocess.run(["osascript", "-e",
        'on run argv\ntell application "Terminal" to close window id (item 1 of argv as integer)\nend run',
        sys.argv[1]])
    os._exit(0)
PY
exit 0
EOF
chmod +x "$L/$NAME.view.command"

# Open the viewer without taking the user's keyboard. -g keeps Terminal in the
# background when another app is in front. When Terminal itself is in front,
# the new window becomes the key window, so give the user's window back as
# soon as the new one exists.
front="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null || true)"
prev=""
before=0
if [ "$front" = Terminal ]; then
  prev="$(osascript -e 'tell application "Terminal" to get id of front window' 2>/dev/null || true)"
  before="$(osascript -e 'tell application "Terminal" to count windows' 2>/dev/null || echo 0)"
fi
open -g -a Terminal "$L/$NAME.view.command"
if [ -n "$prev" ]; then
  for _ in $(seq 1 60); do
    now="$(osascript -e 'tell application "Terminal" to count windows' 2>/dev/null || echo 0)"
    [ "$now" -gt "$before" ] && break
    sleep 0.05
  done
  osascript -e "tell application \"Terminal\" to set index of window id $prev to 1" \
    -e "tell application \"Terminal\" to set frontmost of window id $prev to true" >/dev/null 2>&1 || true
fi
